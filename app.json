{
  "expo": {
    "name": "StoryBook",
    "slug": "housemajor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "storybookapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.housemajor.app"
    },
    "android": {
      "package": "com.housemajor.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "StoryBook uses the microphone so you can record an audio testimony."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "StoryBook uses the camera so you can record a video testimony.",
          "photosPermission": "StoryBook accesses your library so you can attach a video you already filmed.",
          "microphonePermission": "StoryBook uses the microphone to capture sound while recording video."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a9e3e33-8e6b-4788-ab10-9c2005fca833"
      }
    },
    "owner": "nkusibeni"
  }
}
